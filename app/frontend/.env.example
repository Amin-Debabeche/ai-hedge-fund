# Backend API URL the frontend talks to. Defaults to http://localhost:8000
# (the local dev backend) when unset. Set this if you deploy the frontend
# elsewhere (e.g. Vercel) but still run the backend + Ollama locally - the
# browser will call this URL directly, so it must be reachable from wherever
# you open the app (typically still http://localhost:8000, since the backend
# runs on your own machine alongside Ollama).
VITE_API_URL=http://localhost:8000
